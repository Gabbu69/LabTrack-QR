# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Used only for the isolated fictional demo accounts (10+ characters)
DEMO_ACCOUNT_PASSWORD=Replace-With-A-Private-Demo-Password

# One-time deployment bootstrap. Remove after npm run bootstrap:staff succeeds.
BOOTSTRAP_CUSTODIAN_NAME=Lead Tool Custodian
BOOTSTRAP_CUSTODIAN_EMAIL=custodian@school.example
BOOTSTRAP_CUSTODIAN_PASSWORD=Replace-With-One-Time-Password
BOOTSTRAP_INSTRUCTOR_NAME=Laboratory Instructor
BOOTSTRAP_INSTRUCTOR_EMAIL=instructor@school.example
BOOTSTRAP_INSTRUCTOR_PASSWORD=Replace-With-One-Time-Password

# Exact public URL used for redirects and labels
NEXT_PUBLIC_SITE_URL=http://localhost:3000
